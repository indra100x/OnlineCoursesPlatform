# =============================================================================
# CourseAtlas — MonkeysCloud Production Environment
# =============================================================================
# Copy these values into your MonkeysCloud dashboard environment variables.
# Values marked [AUTO] are provided automatically by MonkeysCloud.
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=CourseAtlas
APP_ENV=production
APP_KEY=[GENERATE_WITH: php artisan key:generate --show]
APP_DEBUG=false
APP_URL=[YOUR_MONKEYSCLOUD_URL]
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Database [AUTO] ──────────────────────────────────────────────────────────
# MonkeysCloud provides these automatically when you add PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=[AUTO]
DB_PORT=[AUTO]
DB_DATABASE=[AUTO]
DB_USERNAME=[AUTO]
DB_PASSWORD=[AUTO]

# ── Session ──────────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# ── Cache (file-based, no Redis needed) ─────────────────────────────────────
CACHE_STORE=file

# ── Queue (sync, no Redis needed) ───────────────────────────────────────────
QUEUE_CONNECTION=sync

# ── Broadcasting ─────────────────────────────────────────────────────────────
BROADCAST_CONNECTION=log

# ── Filesystem ───────────────────────────────────────────────────────────────
FILESYSTEM_DISK=public

# ── Mail (configure or leave as log) ────────────────────────────────────────
# For password reset + email verification to work, set a real mailer:
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.mailgun.org
# MAIL_PORT=587
# MAIL_USERNAME=your-mailgun-username
# MAIL_PASSWORD=your-mailgun-password
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS="noreply@yourdomain.com"
# MAIL_FROM_NAME="${APP_NAME}"
MAIL_MAILER=log

# ── Redis (not required — only if you add Redis addon) ──────────────────────
# REDIS_HOST=[AUTO]
# REDIS_PASSWORD=[AUTO]
# REDIS_PORT=6379

# ── Cloudinary (optional — for CDN image storage) ───────────────────────────
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ── Sentry (optional — for error tracking) ──────────────────────────────────
# SENTRY_LARAVEL_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.2

# ── Vite ─────────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
