includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app
    level: 5
    ignoreErrors:
        # JsonResource proxies attributes dynamically from its wrapped Eloquent model.
        - identifier: property.notFound
    excludePaths:
        - vendor/*
        - node_modules/*
        - database/migrations/*
        - resources/*
        - config/*
        - bootstrap/*
        - public/*
